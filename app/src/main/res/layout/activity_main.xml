<?xml version="1.0" encoding="utf-8"?>
<!--
  app/src/main/res/layout/activity_main.xml
  change(add)-hyungchul-20260820: Feed(오디오 공급 속도) 스피너 추가.
    지연(latency) 측정에서 공급 속도가 최대 교란 요인이라 UI에서 고르고 CSV에 함께 기록한다.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingBottom="12dp" />

            <!-- Input -->
            <Button
                android:id="@+id/inputButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_input" />

            <TextView
                android:id="@+id/inputPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/input_none"
                android:paddingBottom="12dp"
                android:textColor="?android:attr/textColorPrimary" />

            <!-- Output -->
            <Button
                android:id="@+id/outputButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_output" />

            <TextView
                android:id="@+id/outputPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/output_none"
                android:paddingBottom="12dp"
                android:textColor="?android:attr/textColorPrimary" />

            <!-- Lang -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lang_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <Spinner
                android:id="@+id/langSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp" />

            <!-- Model -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/model_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <Spinner
                android:id="@+id/modelSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp" />

            <!-- change(add)-hyungchul-20260820 : Feed(오디오 공급 속도) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feed_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <Spinner
                android:id="@+id/feedSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feed_hint"
                android:textSize="12sp"
                android:paddingBottom="12dp"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- Start -->
            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_start"
                android:layout_marginTop="8dp" />

            <!-- 전체 진행률 (0.0% ~ 100.0%) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_title"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/progressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/progress_zero"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="1000"
                android:progress="0" />

            <!-- 진행 로그 (어두운 배경 + 밝은 글자로 항상 잘 보이게) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/log_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingTop="16dp" />

            <TextView
                android:id="@+id/logView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:layout_marginTop="4dp"
                android:padding="8dp"
                android:background="@color/log_background"
                android:textColor="@color/log_text"
                android:fontFamily="monospace"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>