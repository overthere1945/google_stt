<?xml version="1.0" encoding="utf-8"?>
<!--
  app/src/main/res/layout/activity_main.xml
  change(add)-hyungchul-20260820: Feed(오디오 공급 속도) 스피너 추가.
  change(add)-hyungchul-20260825-1430: Silero VAD On/Off + Profile + Custom 파라미터 UI 추가.
  change(add)-hyungchul-20260826-1100: Noise Reduction 알고리즘 선택 + 옵션 UI 추가.
    Feed 스피너와 Start 버튼 사이에만 삽입했고, 기존 위젯의 순서/속성은 하나도 바꾸지 않았다.
    지연(latency) 측정에서 공급 속도가 최대 교란 요인이라 UI에서 고르고 CSV에 함께 기록한다.
  add-hyungchul-20261011-2000: v2.5.0 목록 실행 버튼 6개 + 목록 요약·상태 글을 Start 버튼 바로 아래에 추가.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingBottom="12dp" />

            <!-- Input -->
            <Button
                android:id="@+id/inputButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_input" />

            <TextView
                android:id="@+id/inputPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/input_none"
                android:paddingBottom="12dp"
                android:textColor="?android:attr/textColorPrimary" />

            <!-- Output -->
            <Button
                android:id="@+id/outputButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_output" />

            <TextView
                android:id="@+id/outputPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/output_none"
                android:paddingBottom="12dp"
                android:textColor="?android:attr/textColorPrimary" />

            <!-- Lang -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lang_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <Spinner
                android:id="@+id/langSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp" />

            <!-- Model -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/model_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <Spinner
                android:id="@+id/modelSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp" />

            <!-- change(add)-hyungchul-20260820 : Feed(오디오 공급 속도) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feed_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <Spinner
                android:id="@+id/feedSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feed_hint"
                android:textSize="12sp"
                android:paddingBottom="12dp"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- add-hyungchul-20260825-1430 : Silero VAD (STT 앞단 선택적 전처리) -->
            <!-- change-hyungchul-20261009-1530 : VAD 사용 스위치 + 고정 입력칸 6개 →
                 "VAD 엔진 스피너(사용 안 함 포함) → 프리셋 스피너 → 엔진별 입력칸(코드로 생성)" 으로 바꿨다. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vad_engine_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <Spinner
                android:id="@+id/vadEngineSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp" />

            <LinearLayout
                android:id="@+id/vadOptionsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vad_profile_title"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <Spinner
                    android:id="@+id/vadProfileSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp" />

                <!-- change-hyungchul-20261009-1530 : 엔진별 설정 입력칸을 ui/VadUi.kt 가 이 안에 만든다 -->
                <LinearLayout
                    android:id="@+id/vadParamContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/vadInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vad_hint"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingTop="4dp" />

            </LinearLayout>

            <!-- change-hyungchul-20261009-1530 : 구간 처리(엔진별 최대 길이 / 모든 엔진 10초 통일) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/seg_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <Spinner
                android:id="@+id/segModeSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/seg_hint"
                android:textSize="12sp"
                android:paddingBottom="12dp"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- add-hyungchul-20260914-2350 : Speech EPD (VAD 뒤, STT 바로 앞) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/epd_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingTop="12dp"
                android:paddingBottom="4dp" />

            <Spinner
                android:id="@+id/epdModeSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/epdOptionsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/epd_target_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/epdTargetEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="45"
                    android:hint="45" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/epd_max_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/epdMaxEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="55"
                    android:hint="55" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/epd_silence_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/epdSilenceEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="1000"
                    android:hint="1000" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/epd_hint"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingTop="4dp" />

            </LinearLayout>

            <!-- add-hyungchul-20260826-1100 : Noise Reduction (STT 앞단, VAD 보다 먼저 적용) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ns_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingTop="8dp" />

            <Spinner
                android:id="@+id/nsAlgoSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/nsOptionsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ns_variant_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <Spinner
                    android:id="@+id/nsVariantSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ns_atten_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/nsAttenLimitEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="12"
                    android:hint="12" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ns_threads_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/nsThreadsEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="1"
                    android:hint="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ns_mingain_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/nsMinGainEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberSigned|numberDecimal"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="-20"
                    android:hint="-20" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ns_alpha_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/nsAlphaEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="0.98"
                    android:hint="0.98" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ns_beta_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/nsBetaEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="0.02"
                    android:hint="0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ns_quantile_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/nsQuantileEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="10"
                    android:hint="10" />

                <TextView
                    android:id="@+id/nsHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ns_hint"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingTop="4dp" />

            </LinearLayout>

            <!-- Start -->
            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_start"
                android:layout_marginTop="8dp" />

            <!-- add-hyungchul-20261011-2000 : v2.5.0 목록 실행(ui/PlanUi.kt) — START 아래에만 넣었고 기존 위젯은 바꾸지 않았다 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/plan_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/planAddButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_plan_add" />

                <Button
                    android:id="@+id/planClearButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_plan_clear" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/planSaveButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_plan_save" />

                <Button
                    android:id="@+id/planLoadButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_plan_load" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/planStartButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_plan_start" />

                <Button
                    android:id="@+id/planStopButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:enabled="false"
                    android:text="@string/btn_plan_stop" />
            </LinearLayout>

            <TextView
                android:id="@+id/planSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/planStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- 전체 진행률 (0.0% ~ 100.0%) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_title"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/progressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/progress_zero"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="1000"
                android:progress="0" />

            <!-- 진행 로그 (어두운 배경 + 밝은 글자로 항상 잘 보이게) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/log_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingTop="16dp" />

            <TextView
                android:id="@+id/logView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:layout_marginTop="4dp"
                android:padding="8dp"
                android:background="@color/log_background"
                android:textColor="@color/log_text"
                android:fontFamily="monospace"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>