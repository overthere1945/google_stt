<?xml version="1.0" encoding="utf-8"?>
<!--
  app/src/main/res/layout/activity_main.xml
  change(add)-hyungchul-20260820: Feed(오디오 공급 속도) 스피너 추가.
  change(add)-hyungchul-20260825-1430: Silero VAD On/Off + Profile + Custom 파라미터 UI 추가.
  change(add)-hyungchul-20260826-1100: Noise Reduction 알고리즘 선택 + 옵션 UI 추가.
    Feed 스피너와 Start 버튼 사이에만 삽입했고, 기존 위젯의 순서/속성은 하나도 바꾸지 않았다.
    지연(latency) 측정에서 공급 속도가 최대 교란 요인이라 UI에서 고르고 CSV에 함께 기록한다.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingBottom="12dp" />

            <!-- Input -->
            <Button
                android:id="@+id/inputButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_input" />

            <TextView
                android:id="@+id/inputPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/input_none"
                android:paddingBottom="12dp"
                android:textColor="?android:attr/textColorPrimary" />

            <!-- Output -->
            <Button
                android:id="@+id/outputButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_output" />

            <TextView
                android:id="@+id/outputPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/output_none"
                android:paddingBottom="12dp"
                android:textColor="?android:attr/textColorPrimary" />

            <!-- Lang -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lang_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <Spinner
                android:id="@+id/langSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp" />

            <!-- Model -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/model_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <Spinner
                android:id="@+id/modelSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp" />

            <!-- change(add)-hyungchul-20260820 : Feed(오디오 공급 속도) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feed_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <Spinner
                android:id="@+id/feedSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feed_hint"
                android:textSize="12sp"
                android:paddingBottom="12dp"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- add-hyungchul-20260825-1430 : Silero VAD (STT 앞단 선택적 전처리) -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/vadSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vad_switch"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:checked="false"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <LinearLayout
                android:id="@+id/vadOptionsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vad_profile_title"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <Spinner
                    android:id="@+id/vadProfileSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vad_threshold_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/vadThresholdEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="0.50"
                    android:hint="0.50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vad_min_speech_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/vadMinSpeechEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="100"
                    android:hint="100" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vad_min_silence_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/vadMinSilenceEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="300"
                    android:hint="300" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vad_speech_pad_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/vadSpeechPadEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="200"
                    android:hint="200" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vad_max_speech_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/vadMaxSpeechEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="0"
                    android:hint="0" />

                <!-- add-hyungchul-20260914-2130 : 구간 사이 무음(ms) — PC GUI 의 vad-join-silence-ms -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vad_join_silence_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/vadJoinSilenceEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="200"
                    android:hint="200" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vad_hint"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingTop="4dp" />

            </LinearLayout>

            <!-- add-hyungchul-20260914-2350 : Speech EPD (VAD 뒤, STT 바로 앞) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/epd_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingTop="12dp"
                android:paddingBottom="4dp" />

            <Spinner
                android:id="@+id/epdModeSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/epdOptionsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/epd_target_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/epdTargetEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="45"
                    android:hint="45" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/epd_max_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/epdMaxEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="55"
                    android:hint="55" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/epd_silence_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/epdSilenceEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="1000"
                    android:hint="1000" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/epd_hint"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingTop="4dp" />

            </LinearLayout>

            <!-- add-hyungchul-20260826-1100 : Noise Reduction (STT 앞단, VAD 보다 먼저 적용) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ns_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingTop="8dp" />

            <Spinner
                android:id="@+id/nsAlgoSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/nsOptionsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ns_variant_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <Spinner
                    android:id="@+id/nsVariantSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ns_atten_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/nsAttenLimitEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="12"
                    android:hint="12" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ns_threads_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/nsThreadsEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="1"
                    android:hint="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ns_mingain_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/nsMinGainEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberSigned|numberDecimal"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="-20"
                    android:hint="-20" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ns_alpha_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/nsAlphaEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="0.98"
                    android:hint="0.98" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ns_beta_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/nsBetaEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="0.02"
                    android:hint="0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ns_quantile_title"
                    android:textColor="?android:attr/textColorPrimary" />

                <EditText
                    android:id="@+id/nsQuantileEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1"
                    android:importantForAutofill="no"
                    android:text="10"
                    android:hint="10" />

                <TextView
                    android:id="@+id/nsHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ns_hint"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingTop="4dp" />

            </LinearLayout>

            <!-- Start -->
            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_start"
                android:layout_marginTop="8dp" />

            <!-- 전체 진행률 (0.0% ~ 100.0%) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_title"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/progressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/progress_zero"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="1000"
                android:progress="0" />

            <!-- 진행 로그 (어두운 배경 + 밝은 글자로 항상 잘 보이게) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/log_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingTop="16dp" />

            <TextView
                android:id="@+id/logView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:layout_marginTop="4dp"
                android:padding="8dp"
                android:background="@color/log_background"
                android:textColor="@color/log_text"
                android:fontFamily="monospace"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>