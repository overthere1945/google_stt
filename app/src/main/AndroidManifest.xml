<?xml version="1.0" encoding="utf-8"?>
<!--
  app/src/main/AndroidManifest.xml
  ★ 수정: android:theme 을 프로젝트 테마(@style/Theme.Google_stt)로 되돌렸다.
    (전에 드린 파일은 @style/Theme.AppCompat... 을 직접 가리켜 themes.xml 과 어긋났다.)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      SpeechRecognizer 클래스는 공식 문서상 RECORD_AUDIO 권한을 요구한다.
      (EXTRA_AUDIO_SOURCE 로 파일을 넣는 경우에도 동일하게 요구된다.)
      ML Kit 의 AudioSource.fromPfd() 자체는 권한이 필요 없지만, 같은 앱에서 두 경로를 쓰므로 선언한다.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      ★ 필수: Android 11(API 30)+ 의 패키지 가시성 제한 때문에
      이 <queries> 가 없으면 SpeechRecognizer 가 RecognitionService 를 찾지 못해
      ERROR_CLIENT / 서비스 바인딩 실패가 발생할 수 있다.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Google_stt">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>