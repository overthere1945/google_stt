<?xml version="1.0" encoding="utf-8"?>
<!--
  app/src/main/AndroidManifest.xml
  change(add)-hyungchul-20260820: ACCESS_NETWORK_STATE 추가.
    → result.csv 의 net_type 컬럼(온디바이스 실행 판정 근거)을 채우기 위해 필요하다.
      이 권한은 "네트워크 상태 조회"만 하며 통신을 하지 않는다(INTERNET 권한은 일부러 넣지 않는다).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      SpeechRecognizer 클래스는 공식 문서상 RECORD_AUDIO 권한을 요구한다.
      (EXTRA_AUDIO_SOURCE 로 파일을 넣는 경우에도 동일하게 요구된다.)
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- change(add)-hyungchul-20260820 : 계측용 네트워크 상태 조회 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      add-hyungchul-20261106-1708 : [T4-2] 모델·VAD 자산을 앱이 직접 내려받는다(D1, FR-05-01).
        · INTERNET 은 내려받기에만 쓴다. 전사(추론) 구간에서 앱의 네트워크 송수신이 0 임은 device.csv 의
          net_rx_delta / net_tx_delta 로 증명한다(FR-10-02). 위 20260820 주석의 "INTERNET 을 넣지 않는다" 는 v3 까지의 방침이다.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      add-hyungchul-20261106-1722 : [T4-7] 포그라운드 서비스(받기 모드, 이후 실행 모드)에 필요한 권한(D21, 4단계 5-5).
        · FOREGROUND_SERVICE + FOREGROUND_SERVICE_SPECIAL_USE : 종류 specialUse 의 포그라운드 서비스
        · POST_NOTIFICATIONS : 진행 알림(Android 13+ 는 실행 중 허용을 받아야 알림이 보인다 — 허용 요청은 화면 작업 T7 에서)
        · WAKE_LOCK : 화면이 꺼져도 받기·실행이 이어지게 하는 부분 wake lock
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      add-hyungchul-20261010-2238 : sherpa-onnx STT 모델 읽기용 '모든 파일 접근'(사용자 결정 Q24)
        · 모델 위치: /sdcard/Documents/stt_models/<패키지>/ (PC 에서 adb push 또는 MTP 복사)
        · sherpa-onnx 는 파일 경로로만 모델을 읽는다. .onnx 는 미디어 파일이 아니라 Android 13+ 에서는 이 권한 없이는 공용 폴더의 파일을 경로로 읽을 수 없다.
        · 이전 방식(앱 전용 폴더 Android/data 에 adb 로 넣기)은 adb 가 만든 폴더를 앱이 읽지 못해(canRead=false) 바꿨다.
        · 런타임 대화상자가 없는 특수 권한이다 → 앱이 설정 화면(ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION)을 열어 사용자가 켠다.
        · Google Play 배포 시 정책 심사 대상(내부 평가용 앱이라 해당 없음).
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
      ★ 필수: Android 11(API 30)+ 의 패키지 가시성 제한 때문에
      이 <queries> 가 없으면 SpeechRecognizer 가 RecognitionService 를 찾지 못해
      ERROR_CLIENT / 서비스 바인딩 실패가 발생할 수 있다.
      (계측용 recognition_services 목록 조회에도 이 선언이 필요하다)
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- change-hyungchul-20261106-1722 : [T4-7] android:name=".SttApp" 추가 — 객체 묶음(AppContainer)을 들고 있는 Application -->
    <application
        android:name=".SttApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Google_stt">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          add-hyungchul-20261106-1722 : [T4-7] 포그라운드 서비스. 종류 specialUse — 긴 시간 도는 온디바이스 STT 평가(받기 포함)는
          dataSync 의 시간 제한(Android 15: 24시간에 6시간)에 맞지 않아 specialUse 를 쓴다(D21). 밖에서 시작할 수 없다(exported=false).
        -->
        <service
            android:name=".run.RunService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device STT batch evaluation (long-running, user-started)" />
        </service>
    </application>

</manifest>